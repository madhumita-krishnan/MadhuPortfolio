# Generated by `node build.js`. GitHub Actions rebuilds it on every push, so there is no
# reason to keep a copy in the history — and it would double the size of every commit that
# touches an image.
dist/

# Pre-compression originals of the case-study videos, kept on disk so the re-encode is
# reversible. 21MB of video that must never enter the history — git keeps blobs forever, so
# one `git add .` would permanently bloat the repo. Deliberately NOT under assets/ either,
# because build.js copies assets/ into dist/ wholesale and it would ship to Pages.
_orig-backup/

node_modules/
.DS_Store

# Contact sheets from tools/make-hand-font.js --proof/--glyphs. Development output, kept
# out of assets/ so build.js does not ship them to Pages.
font-proofs/
