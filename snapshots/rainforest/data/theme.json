    "text-on-deep": "#F0F6EF",
    "text-on-deep-secondary": "#A8BFB0",
    "accent": "#1B6E49",
    "accent-deep": "#0F5236",
    "accent-bright": "#3FA772",
    "accent-wash": "#D5E6D7",
    "sun": "#C4892F",
    "line": "rgba(24,38,32,.14)",
    "line-on-deep": "rgba(240,246,239,.16)"
  },
  "glass": {
    "light-bg": "rgba(255,255,255,.44)",
    "light-border": "rgba(255,255,255,.62)",
